# API Configuration
VITE_API_URL=http://localhost:3000

# Resend (transactional email for onboarding/offboarding confirmations)
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=onboarding@yourcompany.com

# Public base URL, used for the logo and the onboarding link inside emails
PUBLIC_APP_URL=https://clientes.cenas-support.com

# Bcc'd on every onboarding/offboarding email sent to a client, and where the
# stale-request reminder is sent (leave empty to disable)
ADMIN_NOTIFICATION_EMAIL=info@cenas.uy

# Reply-to address for every outgoing email (onboarding/offboarding, task
# close summaries, stale-request reminders) - independent of the bcc above,
# since that's often a shared inbox rather than a person
EMAIL_REPLY_TO=mathias@cenas.uy

# Days a pending onboarding/offboarding request can sit before ADMIN_NOTIFICATION_EMAIL
# gets a one-time reminder (requires ADMIN_NOTIFICATION_EMAIL to be set)
ONBOARDING_STALE_DAYS=2

# Opening (creating) or closing a Problem/Change task POSTs a JSON summary
# to this URL, if set (leave empty to disable). payload.event is "opened" or
# "closed". Sent with Authorization: Bearer <token> when
# EXTERNAL_PORTAL_WEBHOOK_TOKEN is also set.
EXTERNAL_PORTAL_WEBHOOK_URL=
EXTERNAL_PORTAL_WEBHOOK_TOKEN=

# Host folder shared (bind-mounted) with other systems on the same host, for
# dropping onboarding/offboarding report JSON files to import - one
# onboarding_requests row per pending_action, matched to a client by name.
# See server/index.js "Inbound onboarding/offboarding report import" for the
# expected JSON shape. Processed files move to <dir>/processed, invalid ones
# to <dir>/failed. Leave empty and the host folder just won't exist - no
# import happens, no code path runs.
ONBOARDING_IMPORT_HOST_DIR=/srv/shared/onboarding-import

# Local hour (24h) the import above runs at, once a day - see TZ below for
# what "local" means
ONBOARDING_IMPORT_HOUR=12

# Container timezone - controls ONBOARDING_IMPORT_HOUR and any other
# local-time-of-day scheduling
TZ=America/Montevideo

# Host folder shared (bind-mounted) with the "servicios cliente" system
# (another container on this host) - this app writes clients.json here
# every hour (active clients only: id, name, slug, email, phone,
# contactPerson), the other system reads it. One-way - nothing is ever
# read back from this folder. Leave empty and the host folder just won't
# exist - no export happens, no code path runs. Trigger a write on demand
# with POST /api/admin/client-export/run while the other side is still
# being built.
CLIENT_EXPORT_HOST_DIR=/srv/shared/client-export